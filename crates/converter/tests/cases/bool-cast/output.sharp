namespace App;

// PHP# has no `(bool)`, and the comparison a condition of the value's type gives replaces it (spec sections 21 and 24).
internal final class Basket
{
    internal List<bool> flags(int count, float? rate, List<string> items)
    {
        return [(count != 0), (rate != null && rate != 0.0), !items.isEmpty()];
    }
}

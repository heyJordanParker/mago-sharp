namespace App;

// A value of no known type that lands in a nullable or a union type PHP declares is checked where it lands, and PHP
// throws a `TypeError` for one the type doesn't hold. One read of the value through `match` does the same, so a call
// runs once, as PHP runs it (spec section 21). The arms name a variable no other code of the file names.
public final class Ledger
{
    internal string? note()
    {
        return match (this.raw()) { string value2 => value2, null => null, default => throw new TypeError("Return value must be of type ?string") };
    }

    internal void record()
    {
        this.log(match (this.raw()) { Loggable value2 => value2, string value2 => value2, default => throw new TypeError("Argument #1 ($detail) must be of type App\\Loggable|string") });
    }

    internal int limited()
    {
        return this.limit(match (this.raw()) { int value2 => value2, null => null, default => throw new TypeError("Argument #1 ($value) must be of type ?int") });
    }

    // PHP returns an `int` where a `float` is declared as that number.
    internal float ratio()
    {
        return match (this.raw()) { float value2 => value2, int value2 => (float) value2, default => throw new TypeError("Return value must be of type float") };
    }

    internal Entry? entry(Loggable? item)
    {
        return match (item) { Entry value2 => value2, null => null, default => throw new TypeError("Return value must be of type ?App\\Entry") };
    }

    private Any? raw()
    {
        return null;
    }

    private void log(string|Loggable detail)
    {
    }

    private int limit(int? value)
    {
        return value ?? 0;
    }
}

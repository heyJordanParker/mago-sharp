namespace App;

// PHP# reaches a static through its class's name or a type parameter, so a static of a `class-string<T>` is `T`'s, as
// `T.find(7)`, and a static call through a class held at run time is a call through reflection, whose `Any?` result
// `as` checks into the call's type (spec sections 11 and 25).
public final class Finder
{
    internal int total<T : Order>(Class<T> kind)
    {
        const found = T.find(7);
        const make = T.find;
        make(1);

        return T.count + T.MAX + (found == null ? 0 : found.id);
    }

    internal string label(Class<Order> kind)
    {
        return kind.methods().first(method => method.name == nameof(Order.label)).invoke(null, [7]) as string ?? throw new TypeError("Return value must be of type string");
    }
}

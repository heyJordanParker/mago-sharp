namespace App;

// `X::class` is the class value `typeof(X)`, `static` is `Self`, and `self` is the class's name (spec section 25).
internal final class Registry
{
    internal Class<Spec> kind()
    {
        return typeof(Spec);
    }

    internal Registry fresh()
    {
        return new Registry();
    }

    internal Self same()
    {
        return this;
    }
}

namespace App;

// `__construct` is the class's name, and a promoted parameter declares a field or a property (spec section 9).
internal final class Order
{
    public Order(
        private Spec spec,
        internal string reference { get; private set; },
        internal int quantity { get; } = 1,
        string note = '',
    ) {
    }

    internal Spec current()
    {
        return this.spec;
    }
}

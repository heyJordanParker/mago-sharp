namespace App;

// PHP changes a function's own copy of an array argument, and a PHP# parameter never changes, so a function that
// changes its parameters copies each one into a `let` local first, which the rest of the body uses (spec section 2).
internal final class Signup
{
    internal int fields(Map<string, string> input, List<string> form, string key)
    {
        let changedInput = input;
        let changedForm = form;
        changedInput[key] = 'signup';
        changedForm.add('email');

        return changedInput.count() + changedForm.count();
    }
}

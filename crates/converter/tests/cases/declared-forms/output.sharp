namespace App;

// A `(bool)` of a declared `bool`, a condition of a call read once, a local typed by an operator of declared values,
// and a `return` whose value first assigns a local (spec sections 2, 3, 21 and 24).
public final class Forms
{
    private int? count = null;

    internal bool flag(bool on)
    {
        return on;
    }

    private int? counted()
    {
        return this.count;
    }

    internal bool shown()
    {
        return (match (this.counted()) { null or 0 => false, default => true }) && true;
    }

    internal bool hidden()
    {
        return (match (this.counted()) { null or 0 => true, default => false });
    }

    internal int computed(bool wide, int count)
    {
        int? size = null;
        if (wide) {
            size = count * 2;
        } else {
            size = 1;
        }

        return size;
    }

    internal string inside(string? text)
    {
        const found = text;
        return (found) != null ? found : '';
    }
}

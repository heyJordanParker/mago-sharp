namespace App;

// A method with `yield` returns an `Iterable` of what it yields, and `yield from` is `yield ...` (spec section 12).
internal final class Lines
{
    internal Iterable<string> lines()
    {
        yield 'a';
        yield ...this.more();
    }

    private Iterable<string> more()
    {
        yield 'b';
    }
}

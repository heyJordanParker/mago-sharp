namespace App;

// A static property and a static method value of a class held at run time, which PHP# reaches through reflection by
// the member's `nameof`: a read and a write through `kind.properties()`, and a lambda over `kind.methods()` (spec
// sections 6.3, 14.3 and 25). A constant has no `nameof`, so an application reads none through reflection, as
// library-fixed-strings shows.
internal final class Reader
{
    internal int count(Class<Order> kind)
    {
        return (kind.properties().first(property => property.name == nameof(Order.count)).get(null) as int ?? throw new TypeError("Value must be of type int")) + 1;
    }

    internal void reset(Class<Order> kind)
    {
        kind.properties().first(property => property.name == nameof(Order.count)).set(null, 0);
    }

    internal Order? first(Class<Order> kind)
    {
        const find = (int id) => kind.methods().first(method => method.name == nameof(Order.find)).createInvoker<Function<Order?(List<Any?>)>>()([id]);

        return find(1);
    }

    internal string code(Class<Order> kind)
    {
        const code = (int id) => kind.methods().first(method => method.name == nameof(Order.code)).createInvoker<Function<Any?(List<Any?>)>>()([id]) as string ?? throw new TypeError("Return value must be of type string");

        return code(1);
    }
}

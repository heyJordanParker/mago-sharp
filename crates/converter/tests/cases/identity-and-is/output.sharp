namespace App;

// `===` is `==` where both sides hold scalar types they share or a side is null, and stays where a side may hold an
// object (spec section 19). `instanceof` and the type tests are `is` and `is not` (spec section 21).
public final class Check
{
    internal bool same(string a, string b)
    {
        return a == b;
    }

    internal bool found(bool|string position)
    {
        return position != false;
    }

    internal bool differ(int a, int b)
    {
        return a != b;
    }

    internal bool missing(Spec? spec)
    {
        return spec == null;
    }

    internal bool exactly(Spec a, Spec b)
    {
        return a === b;
    }

    internal bool special(Spec spec)
    {
        return spec is Special;
    }

    internal bool plain(Spec spec)
    {
        return spec is not Special;
    }

    internal bool text(Any? value)
    {
        return value is string;
    }

    internal bool notText(Any? value)
    {
        return value is not string;
    }

    internal bool nothing(Any? value)
    {
        return value == null;
    }

    internal bool agreed(Any? answer)
    {
        return answer == 'yes' || answer == true;
    }

    internal bool blank(string text)
    {
        return text.isEmpty();
    }

    internal bool filled()
    {
        return (Position.current().directory).isNotEmpty();
    }
}

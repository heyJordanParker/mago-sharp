namespace App;

// A local whose first value says nothing of what it holds takes the type its `@var` tag declares.
internal final class Tally
{
    internal List<string> names()
    {
        List<string> names = [];
        names.add('a');

        return names;
    }

    internal Map<string, int> counts(string name)
    {
        Map<string, int> counts = [:];
        counts[name] = 1;

        return counts;
    }

    internal string? first()
    {
        string? first = null;

        return first;
    }
}

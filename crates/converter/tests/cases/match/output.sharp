namespace App;

// `match` keeps its form: an arm's constants become patterns joined by `or`, and a `match` that stands as a statement
// takes block arms (spec section 21).
internal final class Router
{
    private int hits = 0;

    internal string size(int code)
    {
        return match (code) {
            200 or 201 => 'ok',
            404 => 'missing',
            default => 'other',
        };
    }

    internal void count(int status)
    {
        match (status) {
            200 => { this.hits++; },
            default => { this.hits += 2; },
        }
    }
}

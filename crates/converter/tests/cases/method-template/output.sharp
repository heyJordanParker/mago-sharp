namespace App;

/**
 * A method's own type parameters are in PHPDoc, which PHP# writes after the method's name (spec section 11).
 */
internal class Repository
{
    /**
     * Saves an entity, and gives it back as its own type.
     */
    internal virtual TEntity save<TEntity : Entity>(TEntity entity)
    {
        return entity;
    }

    /**
     * The analysis types the value as wider than `TEntity`, which only a `TEntity` is.
     */
    internal virtual TEntity saved<TEntity : Entity>(TEntity entity)
    {
        return (entity.saved ? entity : new Entity()) as TEntity ?? throw new TypeError("Return value must be of type TEntity");
    }

    internal virtual List<TFound> listed<TFound>(TFound found)
    {
        return [found];
    }
}

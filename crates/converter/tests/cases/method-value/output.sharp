namespace App;

// A method named as a value, `name(...)`, `[$this, 'name']` or `'Class::name'` where a function is declared, is
// PHP#'s method value `this.name` (spec section 14.3).
internal final class Pricing
{
    private int apply(Function<int(int)> rule, int amount)
    {
        return rule(amount);
    }

    private int run(Function<int(int)> rule, int amount)
    {
        return rule(amount);
    }

    private int discounted(int amount)
    {
        return amount - 1;
    }

    private static int doubled(int amount)
    {
        return amount * 2;
    }

    internal int total(int amount)
    {
        const first = this.apply(this.discounted, amount);
        const second = this.apply(Pricing.doubled, first);
        const third = this.run(this.discounted, second);

        return this.run(Pricing.doubled, third);
    }
}

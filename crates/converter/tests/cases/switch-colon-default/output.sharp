namespace App;

// Cases between `:` and `endswitch` are cases in braces, and a case that joins `default` goes, since `default` covers
// it (spec section 21).
public final class Sizes
{
    internal int size(int weight)
    {
        match (weight) {
            30 => {
                return 3;
            },
            default => {
                return 1;
            },
        }
    }
}

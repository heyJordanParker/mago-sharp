namespace App;

// A `switch` whose cases never fall through is a `match` statement with block arms. Cases with no statements of their
// own join the next with `or`, and a `switch` without `default` gains an empty one (spec section 21).
internal final class Router
{
    internal string label(int code)
    {
        let label = 'unknown';
        match (code) {
            200 or 201 => {
                label = 'ok';
            },
            404 => {
                return 'missing';
            },
            default => {
                label = 'other';
            },
        }

        return label;
    }

    internal int kind(int status)
    {
        match (status) {
            10 => {
                return 1;
            },
            20 => {
                return 2;
            },
            default => {},
        }

        return 0;
    }

    // PHP's `null == 10` doesn't hold, so a `null` subject meets no case, as it matches no pattern.
    internal int verb(int? status)
    {
        match (status) {
            10 => {
                return 1;
            },
            default => {},
        }

        return 0;
    }
}

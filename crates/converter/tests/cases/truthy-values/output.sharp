namespace App;

// PHP reads an object as true, and `null`, `false`, `0`, `0.0`, `""`, `"0"` and an empty array as false, so a condition
// of an object that is never null is `true`, and one of a value of no known type or of a union of scalars is one read
// through a `match` on the values PHP reads as false (spec section 21).
public final class Truthy
{
    internal bool never(Truthy other)
    {
        return false;
    }

    internal bool made()
    {
        return (match (this.other()) { default => true }) ? true : false;
    }

    internal bool unknown(Any? value)
    {
        return (match (value) { null or false or 0 or 0.0 or "" or "0" or [] => false, default => true }) ? true : false;
    }

    internal bool either(int|float value)
    {
        return (match (value) { 0 or 0.0 => true, default => false });
    }

    internal Truthy kept(Truthy other, Truthy fallback)
    {
        return other;
    }

    private Truthy other()
    {
        return this;
    }
}

namespace App;

// `mixed` is `Any?`, `?T` is `T?` and `object` is `Object`. `(int)`, `(float)` and `(string)` stay, and PHP's aliases
// become them (spec section 24).
internal final class Convert
{
    internal Any? any(Any? value)
    {
        return value;
    }

    internal int? maybe(int? value)
    {
        return value;
    }

    internal Object thing(Object value)
    {
        return value;
    }

    internal int whole(float value)
    {
        return (int) value + (int) value;
    }

    internal float real(int value)
    {
        return (float) value * 1.5;
    }

    internal string text(int value)
    {
        return (string) value;
    }
}

namespace App;

// A method PHP declares no return type for returns `null` where its body runs on past its last statement, and a PHP#
// method returns on every path, so its body ends with `return null;` there (spec section 7).
public final class Inviter
{
    internal Any? send(string name)
    {
        try {
            this.notify(name);
        } catch (LogicException exception) {
            throw new RuntimeException(exception.getMessage(), 0, exception);
        }
        return null;
    }

    internal Any? some(string name)
    {
        if (name.isEmpty()) {
            return 1;
        }
        this.notify(name);
        return null;
    }

    internal Any? nothing()
    {
        return null;
    }

    internal Any? each(List<string> names)
    {
        for (const name of names) {
            this.notify(name);
        }
        return null;
    }

    internal Any? countdown(int count)
    {
        let left = count;
        while (left > 0) {
            left = left - 1;
        }
        return null;
    }

    internal Any? pick(string name, int count)
    {
        match (count) {
            1 => {
                this.notify(name);
            },
            default => {},
        }
        return null;
    }

    // A body that returns or throws on every path ends as it is.
    internal Any? either(string name)
    {
        if (name.isEmpty()) {
            return 1;
        } else {
            return 2;
        }
    }

    internal Any? fail()
    {
        throw new RuntimeException('no');
    }

    private void notify(string name)
    {
    }
}
